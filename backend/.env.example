# Conexión a PostgreSQL (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timp_ceramica

# Configuración del servidor Fastify
PORT=3000
HOST=0.0.0.0

# Seguridad de sesiones (Regla 5 AGENT_RULES)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
COOKIE_SECRET=super_secret_cookie_signing_key_32_chars
NODE_ENV=development
